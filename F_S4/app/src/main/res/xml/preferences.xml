<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="Information de connexion">

        <EditTextPreference
            app:key="nom"
            app:title="Nom"
            app:summary="Entrer votre nom"
            app:dialogTitle="Nom"/>

        <EditTextPreference
            app:key="password"
            app:title="Mot de passe"
            app:summary="Entrer votre mot de passe"
            app:dialogTitle="Mot de passe"
            app:useSimpleSummaryProvider="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="Parametres">

        <SwitchPreferenceCompat
            app:key="checkBox"
            app:title="Rester connecté"
            app:summary="On/Off"
            app:defaultValue="true" />

        <ListPreference
            app:key="listpref"
            app:title="Liste des préférences"
            app:summary="Liste des préférences"
            app:dialogTitle="Liste des préférences"
            app:entries="@array/options"
            app:entryValues="@array/options_values"
            app:defaultValue="1" />

    </PreferenceCategory>

</PreferenceScreen>